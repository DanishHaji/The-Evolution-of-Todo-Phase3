# Backend Configuration
# ==================

# Database Configuration (Neon PostgreSQL)
# Get your free database at: https://neon.tech/
DATABASE_URL=postgresql://username:password@host/database?sslmode=require

# Cohere AI Configuration
# Get your free API key at: https://dashboard.cohere.com/api-keys
COHERE_API_KEY=your_cohere_api_key_here

# JWT Authentication
# Generate a secure random string for production
JWT_SECRET=your_secure_jwt_secret_here_change_in_production


# Frontend Configuration
# ==================

# Backend API URL
NEXT_PUBLIC_API_URL=http://localhost:8000

# Better Auth Configuration
# Generate a secure random string for production
BETTER_AUTH_SECRET=your_secure_better_auth_secret_here
BETTER_AUTH_URL=http://localhost:3000


# Development Notes
# ==================
# 1. Copy this file to .env in backend/ and .env.local in frontend/
# 2. Replace all placeholder values with your actual credentials
# 3. Never commit .env or .env.local files to version control
# 4. For production, use environment variables from your hosting platform
