# Production Environment Variables for Vercel/Render Deployment
# Copy these values to your hosting platform's environment variables section

# Database Configuration (Neon PostgreSQL)
# Get from: https://console.neon.tech
DATABASE_URL=postgresql://username:password@your-host.neon.tech/neondb?sslmode=require&channel_binding=require

# JWT Authentication Secrets
# Generate using: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=your_production_jwt_secret_here
BETTER_AUTH_SECRET=your_production_better_auth_secret_here

# Cohere AI API Key
# Get from: https://dashboard.cohere.com/api-keys
COHERE_API_KEY=your_cohere_api_key_here

# Environment Settings
ENV=production
DEBUG=false

# IMPORTANT NOTES:
# 1. NEVER commit this file with real values to Git
# 2. Set these in Vercel Dashboard: Settings → Environment Variables
# 3. Or in Render Dashboard: Environment → Environment Variables
# 4. Make sure to use DIFFERENT secrets for production vs development
