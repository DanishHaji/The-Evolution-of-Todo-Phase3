# Database Configuration
# Get this from: https://console.neon.tech (create PostgreSQL database)
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require&channel_binding=require

# Authentication Secrets
# Generate with: openssl rand -hex 32
JWT_SECRET=your_jwt_secret_here_generate_with_openssl
BETTER_AUTH_SECRET=your_better_auth_secret_generate_with_openssl

# AI Model Configuration
# Get API key from: https://dashboard.cohere.com/api-keys
COHERE_API_KEY=your_cohere_api_key_here

# Environment
ENV=development
DEBUG=true
